# Copy this to `.env` and fill in your real values.
# `.env` is gitignored — it stays on your machine.

# Required for the AI chat companion (Me → talk it out)
OPENAI_API_KEY=sk-replace-me

# Optional — model to use for the chat. Defaults to gpt-4o-mini.
# MOODPATH_CHAT_MODEL=gpt-4o

# Optional — JWT signing secret. Set this for production deploys.
# MINDPATH_SECRET=change-me-to-a-long-random-string
